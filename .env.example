# email-doctor environment template — copy to .env (never commit .env)

# Backend bind address / port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where isolated job workspaces live (default: <system temp>/email_doctor_jobs)
# JOBS_ROOT=

# SQLite job registry path (default: backend/jobs.db)
# JOBS_DB=

# Max bytes accepted per job upload
MAX_UPLOAD_BYTES=209715200

# Browser-visible URLs used by the OAuth callback and popup message.
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# OAuth apps are required for Gmail/Google Workspace and Outlook/Microsoft 365.
# Register these redirect URIs with the corresponding provider:
#   http://localhost:8000/api/mail/oauth/google/callback
#   http://localhost:8000/api/mail/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
# Optional for public-client registrations; required for confidential clients.
MICROSOFT_OAUTH_CLIENT_SECRET=

# Publish a partial audit after the first message and every N messages afterward.
MAIL_SNAPSHOT_EVERY_MESSAGES=25
